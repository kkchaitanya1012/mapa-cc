# Copy to .env and fill in from your Supabase project.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Settings -> Database -> Connection string (use the "Session pooler" URI). Owner role: keep it secret.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Reminder chat: "rules" works offline; "gemini" needs a key.
CHAT_PROVIDER=rules
GEMINI_API_KEY=

# Calls: LiveKit Cloud project (Settings -> Keys). Free tier is plenty.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Voice: Sarvam does the hearing, the speaking and (by default) the thinking, in English and Telugu.
# Gemini is an optional alternative: set LLM_PROVIDER=gemini and GEMINI_API_KEY.
LLM_PROVIDER=sarvam
SARVAM_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal keeps replies fast enough for a phone call
GEMINI_THINKING=minimal

# Push (rings a locked or closed phone): Firebase project -> Project settings -> Service accounts ->
# Generate new private key. Save the JSON somewhere outside the repo and put its path here.
FCM_SERVICE_ACCOUNT_FILE=
